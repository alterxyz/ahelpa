{
  "name": "ahelpa",
  "version": "0.8.0",
  "description": "Agent Help Agent — skill-shaped agent enhancement system",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "ahelpa": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile=dist/ahelpa && rm -f .*.bun-build",
    "package:skill": "bun run scripts/package-skill.ts",
    "install:skill": "bun run src/cli.ts install-skill --source ./skill",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "closure:gate": "bash scripts/closure-gate.sh"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "^5.9.0"
  }
}
